# Copy this file to .env and fill in real values. Never commit .env — it's gitignored.

# MongoDB Atlas connection string.
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority"

## CLOUDINARY CONFIGURATION
# Full credentials URL (cloud name + API key + API secret) — server-side only, never exposed
# to the browser. Used for signed uploads / the Admin API.
CLOUDINARY_URL="cloudinary://<api_key>:<api_secret>@<cloud_name>"
# Public cloud name only (no secret) — read by the client-side <CldImage> component.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="<cloud_name>"

## AUTH CONFIGURATION
# Long random string that signs/verifies session JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="<generate-a-long-random-string>"
# The email address the seed script (npm run seed:admin) will promote to super_admin.
SUPER_ADMIN_EMAIL="admin@agriminds.org"
